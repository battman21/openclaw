FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

COPY scripts/docker/ensure-ca-certificates.sh /usr/local/bin/openclaw-ensure-ca-certificates
COPY scripts/docker/ensure-pip-certifi.sh /usr/local/bin/openclaw-ensure-pip-certifi
COPY scripts/docker/requirements-pip-certifi.txt /tmp/requirements-pip-certifi.txt

# Python stdlib uses the distro trust store. pip and certifi ship their own
# bundles, so install at least the patched floors (CVE-2026-111943).
RUN chmod +x /usr/local/bin/openclaw-ensure-ca-certificates /usr/local/bin/openclaw-ensure-pip-certifi \
  && apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    jq \
    python3 \
    python3-pip \
    ripgrep \
  && openclaw-ensure-ca-certificates \
  && python3 -m pip install --break-system-packages --upgrade -r /tmp/requirements-pip-certifi.txt \
  && openclaw-ensure-pip-certifi \
  && rm -rf /var/lib/apt/lists/* /tmp/requirements-pip-certifi.txt

RUN useradd --create-home --shell /bin/bash sandbox
USER sandbox
WORKDIR /home/sandbox

CMD ["sleep", "infinity"]
